# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Site ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Vercel CLI (opcional — só pra `vercel deploy` local) ===
# Crie em https://vercel.com/account/tokens — NUNCA commite o valor real.
# Se o token vazou (chat, print, etc.), apague no painel e gere outro.
# VERCEL_TOKEN=

# === Gateway de pagamento PIX ===
# Voce pode ter os DOIS configurados ao mesmo tempo. O gateway ativo e
# escolhido no painel admin em /admin/pagamento (salvo na tabela app_config).

# --- OneTimePay ---
# Pegue em: https://app.onetimepay.com.br/painel (Configuracoes > API)
# Webhook (cadastre no painel deles): https://SEU_SITE/api/pagamento/webhook
ONETIMEPAY_PUBLIC_KEY=pub_xxx
ONETIMEPAY_SECRET_KEY=sec_xxx
# (opcional, default: https://app.onetimepay.com.br/api/v1)
# ONETIMEPAY_API_URL=

# --- MarchaBB ---
# Pegue em: https://app.marchabb.com/integrations
# Doc: https://app.marchabb.com/docs/intro/first-steps
# Webhook (cadastre no painel deles): https://SEU_SITE/api/pagamento/webhook/marchabb
MARCHABB_PUBLIC_KEY=pk_xxx
MARCHABB_SECRET_KEY=sk_xxx
# (opcional, default: https://api.marchabb.com/v1)
# MARCHABB_API_URL=

# --- HyzePay ---
# Doc: https://hyzepay.readme.io/reference/introducao
# Pegue em: painel HyzePay > Credenciais API
# Webhook (cadastre no painel deles): https://SEU_SITE/api/pagamento/webhook/hyzepay
HYZEPAY_PUBLIC_KEY=hyzepay_live_xxx
HYZEPAY_SECRET_KEY=sk_live_xxx
# Company ID — opcional, so usado se for configurar split de pagamento
# HYZEPAY_COMPANY_ID=00000000000000000000000000000000
# (opcional, default: https://api.hyzepay.com)
# HYZEPAY_API_URL=

# --- Play Payments ---
# Doc: https://app.playpayments.com.br/docs
# Pegue em: Dashboard > Chaves de API (use a SECRET key, sk_prod_...)
# Webhook (cadastre no painel deles em Configuracoes > Webhooks):
#   https://SEU_SITE/api/pagamento/webhook/playpayments
PLAYPAYMENTS_SECRET_KEY=sk_prod_xxx
# Public key (opcional — so leitura; a API usa a secret key)
# PLAYPAYMENTS_PUBLIC_KEY=pk_prod_xxx
# Secret de assinatura do webhook (whsec_...) — usado pra validar o postback
PLAYPAYMENTS_WEBHOOK_SECRET=whsec_xxx
# Deixe "true" so DEPOIS de confirmar nos logs o header/formato de assinatura;
# ativa a rejeicao (401) de webhooks com assinatura invalida.
# PLAYPAYMENTS_WEBHOOK_STRICT=false
# (opcional, default: https://app.playpayments.com.br/api)
# PLAYPAYMENTS_API_URL=

# --- CenturionPay ---
# Pegue em: painel CenturionPay > Integrações > Chaves de API
# Doc: https://centurion.readme.io/
# Webhook (cadastre no painel deles): https://SEU_SITE/api/pagamento/webhook/centurionpay
CENTURIONPAY_SECRET_KEY=sk_live_xxx
CENTURIONPAY_COMPANY_ID=00000000-0000-0000-0000-000000000000
# (opcional, default: https://api.centurionpay.com.br/functions/v1)
# CENTURIONPAY_API_URL=

# === SMS (Axtron) ===
# Disparado automaticamente quando o cliente clica em "Finalizar Compra"
# com CPF valido. Limite de 1 SMS por CPF a cada 30 dias (controlado no banco).
# Token: https://axtron.io > Configuracoes > API
AXTRON_SMS_TOKEN=sms_xxx
